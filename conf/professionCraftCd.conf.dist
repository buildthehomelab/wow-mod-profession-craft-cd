#
# mod-profession-craft-cd
#
# Removes Classic / TBC / WotLK profession craft cooldowns via
# spell_cooldown_overrides (SQL) and Salt Shaker item_template CDs.
# Does not change engineering gadget uses, potions, or hearthstones.
#
# Companion core skill-up (set in worldserver.conf, not this module):
#   SkillGain.Crafting = 3
#
[worldserver]

# ProfessionCraftCd.Enabled
#        Description: After a craft whose spell_cooldown_overrides row is 0/0, push
#                     the zero cooldown to the 3.3.5 client (it otherwise starts the
#                     Spell.dbc timer). The server-side CD removal is SQL-only and
#                     applies either way.
#        Default:     1 (enabled)
ProfessionCraftCd.Enabled = 1
